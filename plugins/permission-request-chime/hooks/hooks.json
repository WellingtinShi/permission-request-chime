{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/play-chime.sh\"",
            "timeout": 3,
            "statusMessage": "Playing permission request chime"
          }
        ]
      }
    ]
  }
}
